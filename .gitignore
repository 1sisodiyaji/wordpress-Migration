# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── generated / project data (source-only repo) ─────────────────────────────
# Merged project folders (data + generated React/GrapeJS apps)
/Projects/*
!/Projects/registry.json
!/Projects/.gitkeep

# Local WordPress dumps under Docker
/Docker/try-data/
*.sql
!Converter/export-schema/**

# Import / export scratch / packaged plugin zips
**/import/
**/plugin-export*.zip
**/wp-grape-export*.zip
!Plugin/

# ─── build / tooling output ─────────────────────────────────────────────────
/build
/dist
/coverage
.react-router
.next/
/out/
*.tsbuildinfo
next-env.d.ts

# ─── local Admin auth / session data ────────────────────────────────────────
.studio-data/

# ─── logs & OS / editor noise ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
.vercel
.claude/settings.local.json

# ─── local IDE ──────────────────────────────────────────────────────────────
.cursor/*
!.cursor/rules/
