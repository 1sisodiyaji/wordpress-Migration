# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── generated / site project data (keep repo as source-only) ────────────────
# Migrated WP site snapshots imported by Studio / plugin
/sites/
/public/sites/
/public/preview-static/
/public/wp-migrated/

# Generated React + GrapeJS editor apps
/projects/

# Local WordPress dumps, zips, and extracted site trees used for Docker / import
/try-data/
old_wp_data/
*.sql
!export-schema/**

# Import / export scratch / packaged plugin zips (keep plugin source under wp-plugin/)
**/import/
**/plugin-export*.zip
**/wp-grape-export*.zip
!wp-plugin/wp-grape-export/

# ─── build / tooling output ─────────────────────────────────────────────────
/build
/dist
/coverage
.react-router
.next/
/out/
*.tsbuildinfo
next-env.d.ts

# ─── local Studio auth / session data ───────────────────────────────────────
.studio-data/

# ─── logs & OS / editor noise ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
.vercel
.claude/settings.local.json

# ─── local IDE (optional — keep shared Cursor rules) ────────────────────────
.cursor/*
!.cursor/rules/
