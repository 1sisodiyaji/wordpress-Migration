# Copy to .env and adjust. Compose also interpolates WP_URL / WORDPRESS_URL.

STUDIO_PORT=4000
CONVERTER_PORT=5174

# Admin → Converter (use http://localhost:5174 when running both on the host)
CONVERTER_URL=http://converter:5174

# Generated sites and scratch dirs (Docker compose sets these to /app/output and /app/tmp)
PROJECTS_ROOT=./output
TMP_DIR=./tmp

# WordPress stays in the Migration repo. From Docker Desktop / compose extra_hosts:
WP_URL=http://host.docker.internal:8084
WORDPRESS_URL=http://host.docker.internal:8084

# Optional Admin OAuth
# GOOGLE_CLIENT_ID=
# GITHUB_CLIENT_ID=
