# Copy to docker/.env and adjust if needed.
# WordPress: http://localhost:8080
# Admin:     http://localhost:8080/wp-admin  (user/password below)

WP_PORT=8080
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

# First-time install (wp-cli setup script)
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=WP Migrate Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Comma-separated origins allowed to call the plugin REST API (React dev server).
WP_MIGRATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
