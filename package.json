{
  "name": "wp-scrape-to-grapejs",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx Admin/server/index.ts",
    "admin": "tsx Admin/server/index.ts",
    "converter": "tsx Converter/server/index.ts",
    "generate": "tsx Converter/index.ts",
    "wp:up": "powershell -ExecutionPolicy Bypass -File Scripts/start-wordpress.ps1",
    "wp:down": "docker compose -f Docker/docker-compose.yml down",
    "wp:fresh:up": "powershell -ExecutionPolicy Bypass -File Scripts/start-wordpress-fresh.ps1",
    "wp:fresh:down": "powershell -ExecutionPolicy Bypass -File Scripts/stop-wordpress-fresh.ps1",
    "plugin:sync": "tsx Scripts/sync-plugin-export.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint Converter Admin Scripts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.0"
  }
}
