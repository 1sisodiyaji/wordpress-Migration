{
  "name": "pen-migration",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx Admin/server/index.ts",
    "admin": "tsx Admin/server/index.ts",
    "converter": "tsx Converter/server/index.ts",
    "generate": "tsx Converter/index.ts",
    "build": "vite build --config Admin/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint Converter Admin",
    "docker:dev": "docker compose -f compose.dev.yml up --build",
    "docker:prod": "docker compose -f compose.prod.yml up --build",
    "docker:build": "docker compose -f compose.prod.yml build",
    "docker:push": "docker push golusingh07/pen-wordpress-migrator-admin:latest && docker push golusingh07/pen-wordpress-migrator-converter:latest"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.0"
  }
}
