{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["Converter/shared/*"]
    },
    "types": ["node"]
  },
  "include": [
    "shared/**/*.ts",
    "Converter/**/*.ts",
    "Converter/**/*.tsx",
    "Admin/**/*.ts",
    "Admin/**/*.tsx",
    "Admin/**/*.jsx",
    "data/automation/template-migrate/**/*.ts"
  ],
  "exclude": ["node_modules", "output/**", "tmp/**", "Admin/dist/**"]
}
