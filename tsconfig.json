{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["lib/*"]
    },
    "types": ["node"]
  },
  "include": ["scraper/**/*.ts", "generator/**/*.ts", "lib/**/*.ts", "studio/**/*.ts", "studio/**/*.tsx", "studio/**/*.jsx", "scripts/**/*.ts"],
  "exclude": ["node_modules", "projects/**", "sites/**", "public/**"]
}
